# Copy this file to ".env" (same folder as main.py) and edit it. Real environment variables win over this file.

# --- Required for real use ---------------------------------------------------
DEMO_MODE=0                       # 1 = demo logins (admin/admin123, guard/guard123), RESET button, fake demo residents
SECRET_KEY=                       # long random text; logins reset on every restart if empty.  python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_PASSWORD=                   # password of the first admin account (only used when the database has no users yet)
WEBHOOK_API_KEY=                  # the AI cameras send this as header X-API-Key
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000   # the address people open the dashboard on

# --- Community rules ---------------------------------------------------------
MAX_PER_UNIT=4                    # registered residents per house (the site plan has 60 houses). 1 = one per house
TIMEZONE=Asia/Kuala_Lumpur

# --- Alerts housekeeping -----------------------------------------------------
STALE_HOURS=24                    # an open alert older than this counts as "old" (lost-pet alerts are never auto-closed)
AUTO_RESOLVE=1                    # 1 = close old alerts automatically every 10 minutes, 0 = only via the "Clear old" button
FEED_LIMIT=40                     # newest open alerts shown (the latest alert of every open track is always shown too)
TRACK_WINDOW_MIN=120              # a target's path only uses sightings from the last N minutes

# --- Optional: push notifications --------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# NOTIFY_LANG=en                  # en or ms
# NOTIFY_TYPES=                   # empty = every type, e.g. suspicious_person,unregistered_vehicle

# --- Optional: database ------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/simeguard
